# Copy to `.env.local` for local development (`.env.local` is gitignored).
# Required vars have no default and crash the process at boot if unset.

# ── Runtime ──────────────────────────────────────────────────────────
NODE_ENV=development
DEPLOY_ENV=local
SERVICE_NAME=api
PORT=8000
# LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────────────
# Pooled connection for the app's Drizzle pool.
DATABASE_URL=postgresql://user:password@localhost:5432/postgres
# Session-mode (direct) connection — required by migrations + pg-boss.
# Same host as DATABASE_URL locally; a separate direct URL in prod.
DIRECT_DATABASE_URL=postgresql://user:password@localhost:5432/postgres

# ── URLs ─────────────────────────────────────────────────────────────
SELF_BASE_URL=http://localhost:8000
DASHBOARD_URL=http://localhost:3000

# ── Auth ─────────────────────────────────────────────────────────────
# `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-with-a-strong-random-secret
# Shared secret for internal service-to-service calls (x-service-api-key).
INTERNAL_API_KEY=replace-with-a-strong-random-key

# ── AWS / S3 / SES (all optional — features degrade if unset) ─────────
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_REGION=
# SES_FROM_EMAIL=Acme <noreply@notify.example.com>
# SES_REGION=
# SES_CONFIGURATION_SET=
