{
  "name": "@repo/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "types": "dist/src/trpc/public.d.ts",
  "exports": {
    "./trpc": {
      "types": "./dist/src/trpc/public.d.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "nest build && tsc-alias",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "auth:generate": "pnpx @better-auth/cli generate --config ./src/core/auth/better-auth/cli.ts --output ./src/core/database/schema/auth/better-auth.ts --yes",
    "db:generate": "DRIZZLE_ENV_FILE=.env.local drizzle-kit generate",
    "db:migrate": "DRIZZLE_ENV_FILE=.env.local drizzle-kit migrate",
    "db:migrate:prod": "node dist/scripts/migrate.js",
    "db:studio": "DRIZZLE_ENV_FILE=.env.local drizzle-kit studio",
    "env:upload:prod": "./scripts/upload-prod-env.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1081.0",
    "@aws-sdk/client-ses": "^3.1081.0",
    "@aws-sdk/s3-request-presigner": "^3.1081.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@repo/schemas": "workspace:*",
    "@trpc/server": "^11.18.0",
    "better-auth": "^1.6.23",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.4.0",
    "pg": "^8.22.0",
    "pg-boss": "^12.25.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "superjson": "^2.2.6",
    "uuidv7": "^1.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@repo/config": "workspace:*",
    "@swc/core": "^1.15.43",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "source-map-support": "^0.5.21",
    "tsc-alias": "^1.9.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.10"
  }
}
