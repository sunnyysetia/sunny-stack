{
  "extends": "@repo/config/tsconfig/nestjs.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./",
    "paths": {
      "@/*": ["./src/*"]
    },

    "strictNullChecks": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    "drizzle.config.ts",
    "vitest.config.ts",
    "vitest.shared.ts"
  ]
}
