{
  "name": "@repo/utils",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "html-to-text": "^10.0.0"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/html-to-text": "^9.0.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
